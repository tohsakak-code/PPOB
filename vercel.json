{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "style.css",
        "app.js",
        "db.json",
        "products_vip.json",
        "favicon.png",
        "logo.png",
        "images/**",
        "logos/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?path=$1"
    }
  ]
}
